# ─────────────────────────────
# Dependencies (never copy)
# ─────────────────────────────
node_modules
vendor

# ─────────────────────────────
# Git
# ─────────────────────────────
.git
.gitignore

# ─────────────────────────────
# Environment files (security)
# ─────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────
# Logs
# ─────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ─────────────────────────────
# Laravel runtime (safe to exclude)
# ─────────────────────────────
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views
bootstrap/cache

# ─────────────────────────────
# Testing / CI
# ─────────────────────────────
.phpunit.result.cache
.phpunit.cache
coverage

# ─────────────────────────────
# Frontend build artifacts
# ─────────────────────────────
public/build
public/mix-manifest.json

# ─────────────────────────────
# OS / IDE junk
# ─────────────────────────────
.DS_Store
Thumbs.db
.idea
.vscode

# ─────────────────────────────
# Local docker files (optional)
# ─────────────────────────────
docker-compose.yml
Dockerfile